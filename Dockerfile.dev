FROM node:22-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci
ENV NODE_ENV=development
EXPOSE 3000
# --strictPort: fail loudly rather than drift to another port, which would leave
# the published mapping pointing at nothing and the monitor reporting a refusal.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000", "--strictPort"]
